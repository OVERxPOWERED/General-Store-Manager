generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  STAFF
}

enum BillStatus {
  DRAFT
  FINALIZED
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  BANK_TRANSFER
  CREDIT
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      Role     @default(STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bills     Bill[]       @relation("UserBills")
  payments  Payment[]    @relation("UserPayments")
  purchases Purchase[]   @relation("UserPurchases")

  @@map("users")
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  phone     String?
  address   String?
  gstin     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bills Bill[]

  @@index([email])
  @@index([phone])
  @@map("customers")
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  phone     String?
  address   String?
  gstin     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases Purchase[]

  @@index([email])
  @@index([phone])
  @@map("suppliers")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  sku         String   @unique
  barcode     String?  @unique
  unit        String   @default("PCS")
  hsnCode     String?
  taxRate     Float    @default(18)
  purchasePrice Float  @default(0)
  salePrice   Float    @default(0)
  stock       Int      @default(0)
  minStock    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  billItems     BillItem[]
  purchaseItems PurchaseItem[]

  @@index([sku])
  @@index([barcode])
  @@index([isActive])
  @@map("products")
}

model Bill {
  id            String      @id @default(cuid())
  billNumber    String      @unique
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id])
  userId        String
  user          User        @relation("UserBills", fields: [userId], references: [id])
  status        BillStatus  @default(DRAFT)
  subtotal      Float       @default(0)
  taxAmount     Float       @default(0)
  discount      Float       @default(0)
  totalAmount   Float       @default(0)
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  items     BillItem[]
  payments  Payment[]

  @@index([customerId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("bills")
}

model BillItem {
  id        String @id @default(cuid())
  billId    String
  bill      Bill   @relation(fields: [billId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float
  taxRate   Float
  discount  Float @default(0)
  lineTotal Float

  @@index([billId])
  @@index([productId])
  @@map("bill_items")
}

model Payment {
  id          String        @id @default(cuid())
  billId      String
  bill        Bill          @relation(fields: [billId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation("UserPayments", fields: [userId], references: [id])
  amount      Float
  method      PaymentMethod
  reference   String?
  paidAt      DateTime      @default(now())

  @@index([billId])
  @@index([userId])
  @@index([paidAt])
  @@map("payments")
}

model Purchase {
  id            String         @id @default(cuid())
  purchaseNumber String        @unique
  supplierId    String
  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  userId        String
  user          User           @relation("UserPurchases", fields: [userId], references: [id])
  status        PurchaseStatus @default(DRAFT)
  subtotal      Float          @default(0)
  taxAmount     Float          @default(0)
  discount      Float          @default(0)
  totalAmount   Float          @default(0)
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  items PurchaseItem[]

  @@index([supplierId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("purchases")
}

model PurchaseItem {
  id        String @id @default(cuid())
  purchaseId String
  purchase  Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float
  taxRate   Float
  discount  Float @default(0)
  lineTotal Float

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model Settings {
  id            String @id @default(cuid())
  key           String @unique
  value         String
  description   String?
  updatedAt     DateTime @updatedAt

  @@map("settings")
}